{
	"schemaVersion": 1,
	"id": "savestate-practice",
	"version": "${version}",
	"name": "Savestate Practice",
	"description": "Savestate / loadstate for Minecraft 1.16.1 speedrun practice. Uses SpeedrunAPI instead of Fabric API.",
	"authors": [
		"naari3"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.naari3.savestate.SavestateMod"
		]
	},
	"custom": {
		"speedrunapi": {
			"config": "net.naari3.savestate.SavestateConfig"
		}
	},
	"mixins": [
		"savestate-practice.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "1.16.1",
		"speedrunapi": ">=2.2"
	}
}
